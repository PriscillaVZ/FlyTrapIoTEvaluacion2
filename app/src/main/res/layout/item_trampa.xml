<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/contenedorTrampa"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp" >

    <TextView
        android:id="@+id/tvItemCodigo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Código: AZ-001"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvItemTipo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tipo: McPhai"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvItemNivel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Capturas: 12"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvItemObservaciones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Observaciones: Sin novedades"
        android:textSize="16sp" />
</LinearLayout>